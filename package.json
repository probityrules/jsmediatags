{
  "name": "@probityrules/jsmediatags",
  "version": "4.0.2",
  "description": "Media Tags Reader (ID3, MP4)",
  "author": {
    "name": "António Afonso",
    "email": "antonio.afonso@gmail.com"
  },
  "contributors": [
    {
      "name": "Jacob Seidelin"
    },
    {
      "name": "Joshua Kifer"
    },
    {
      "name": "Jesse Ditson",
      "email": "jesse.ditson@gmail.com"
    },
    {
      "name": "Derek Detweiler",
      "email": "derek.detweiler@gmail.com",
      "url": "https://github.com/probityrules"
    }
  ],
  "main": "build/jsmediatags.js",
  "types": "build/jsmediatags.d.ts",
  "exports": {
    ".": {
      "types": "./build/jsmediatags.d.ts",
      "browser": {
        "import": "./dist/jsmediatags.browser.mjs",
        "require": "./dist/jsmediatags.browser.cjs",
        "default": "./dist/jsmediatags.browser.mjs"
      },
      "import": "./build/jsmediatags.js",
      "require": "./build/jsmediatags.js",
      "default": "./build/jsmediatags.js"
    },
    "./browser": "./dist/jsmediatags.min.js",
    "./types": {
      "types": "./build/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "dist/jsmediatags.min.js",
    "dist/jsmediatags.browser.cjs",
    "dist/jsmediatags.browser.mjs",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probityrules/jsmediatags.git"
  },
  "keywords": [
    "ID3",
    "tags",
    "mp3",
    "audio",
    "mp4"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/probityrules/jsmediatags/issues"
  },
  "homepage": "https://github.com/probityrules/jsmediatags#readme",
  "react-native": {
    "fs": false,
    "./NodeFileReader": false
  },
  "dependencies": {
    "xhr2": "^0.1.4"
  },
  "peerDependencies": {
    "buffer": "^6.0.3",
    "react-native-fs": "^2.9.2"
  },
  "peerDependenciesMeta": {
    "buffer": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "tsc",
    "build:browser": "node scripts/build-browser.mjs",
    "watch": "tsc --watch",
    "dist": "npm run build:browser",
    "dist-watch": "node scripts/build-browser.mjs --watch",
    "prepublishOnly": "npm run build && npm run dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
